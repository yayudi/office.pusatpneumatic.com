{
  "explorer.fileNesting.enabled": true,
  "explorer.fileNesting.patterns": {
    "vite.config.*": "jsconfig*, vitest.config.*, cypress.config.*, playwright.config.*",
    "package.json": "package-lock.json, pnpm*, .yarnrc*, yarn*, .eslint*, eslint*, .oxlint*, oxlint*, .prettier*, prettier*, .editorconfig"
  },
  "editor.codeActionsOnSave": {
    "source.fixAll": "explicit"
  },
  "editor.formatOnSave": true,
  "typescript.validate.enable": false,
  "todo-tree.tree.disableCompactFolders": true,
  "workbench.colorCustomizations": {
    "editor.wordHighlightBackground": "#1a456b90",
    "editor.wordHighlightBorder": "#00000000",
    "editor.wordHighlightStrongBackground": "#1a456b90",
    "editor.wordHighlightStrongBorder": "#00000000",
    "activityBar.background": "#42b883",
    "statusBar.background": "#42b883",
    "statusBar.noFolderBackground": "#42b883",
    "activityBar.foreground": "#000000",
    "activityBar.inactiveForeground": "#000000",
    "statusBar.foreground": "#000000"
  }
}
