{
  "rules": {
    "object-curly-newline": [
      "error",
      {
        "ObjectExpression": {
          "minProperties": 3,
          "multiline": true,
          "consistent": true
        },
        "ObjectPattern": {
          "minProperties": 3,
          "multiline": true,
          "consistent": true
        }
      }
    ],
    "array-bracket-newline": ["error", { "minItems": 3 }],
    "array-element-newline": ["error", { "minItems": 3 }]
  }
}
